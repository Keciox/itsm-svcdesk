              "shortDescription": {
                "markdown": "CVE-2024-37891: urllib3's Proxy-Authorization request header isn't stripped during cross-origin redirects",
                "text": "CVE-2024-37891: urllib3's Proxy-Authorization request header isn't stripped during cross-origin redirects"
